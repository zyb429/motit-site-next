generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/"
}

datasource db {
  provider = "mysql"
}

model categories {
  id                     Int                      @id @default(autoincrement()) @db.UnsignedInt
  uuid                   String                   @unique(map: "idx_categories_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  document_id            String?                  @db.VarChar(255)
  name                   String?                  @db.VarChar(255)
  slug                   String?                  @unique(map: "idx_categories_slug") @db.VarChar(255)
  description            String?                  @db.LongText
  icon                   String?                  @db.VarChar(255)
  created_at             DateTime?                @db.DateTime(6)
  updated_at             DateTime?                @db.DateTime(6)
  published_at           DateTime?                @db.DateTime(6)
  created_by_id          Int?                     @db.UnsignedInt
  updated_by_id          Int?                     @db.UnsignedInt
  locale                 String?                  @db.VarChar(255)
  posts_categories_links posts_categories_links[]

  @@index([document_id], map: "idx_categories_document_id")
}

model certificates {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique(map: "idx_certificates_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  title         String    @db.VarChar(255)
  issuer_id     BigInt?   @db.UnsignedBigInt
  image_url     String?   @db.VarChar(500)
  issue_date    DateTime? @db.Date
  expiry_date   DateTime? @db.Date
  is_active     Boolean?  @default(true)
  order         Int?      @default(0)
  created_by_id Int?      @db.UnsignedInt
  updated_by_id Int?      @db.UnsignedInt
  locale        String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  issuers       issuers?  @relation(fields: [issuer_id], references: [id], onUpdate: NoAction, map: "fk_certificates_issuer")

  @@index([issuer_id], map: "idx_certificates_issuer")
}

model client_organizations {
  id                BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  client_user_uuid  String        @db.Char(36)
  organization_uuid String        @db.Char(36)
  role_in_company   String?       @default("member") @db.VarChar(50)
  is_primary        Boolean?      @default(false)
  created_by_id     Int?          @db.UnsignedInt
  updated_by_id     Int?          @db.UnsignedInt
  locale            String?       @db.VarChar(255)
  joined_at         DateTime?     @default(now()) @db.Timestamp(0)
  created_at        DateTime?     @default(now()) @db.Timestamp(0)
  updated_at        DateTime?     @default(now()) @db.Timestamp(0)
  users             users         @relation(fields: [client_user_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_client_org_client")
  organizations     organizations @relation(fields: [organization_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_client_org_org")

  @@unique([client_user_uuid, organization_uuid], map: "idx_client_org_unique")
  @@index([client_user_uuid], map: "idx_client_org_client")
  @@index([organization_uuid], map: "idx_client_org_org")
}

model clients {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique(map: "idx_clients_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  user_uuid     String    @unique(map: "idx_clients_user_uuid") @db.Char(36)
  created_by_id Int?      @db.UnsignedInt
  updated_by_id Int?      @db.UnsignedInt
  locale        String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  users         users     @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_clients_user")
}

model files {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  uuid             String    @unique(map: "idx_files_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  document_id      String?   @db.VarChar(255)
  name             String    @db.VarChar(255)
  alternative_text String?   @db.VarChar(255)
  caption          String?   @db.VarChar(255)
  mime             String?   @db.VarChar(100)
  ext              String?   @db.VarChar(20)
  size             Int?      @db.UnsignedInt
  url              String    @db.VarChar(500)
  preview_url      String?   @db.VarChar(500)
  width            Int?
  height           Int?
  hash             String?   @db.VarChar(255)
  provider         String?   @default("s3") @db.VarChar(50)
  folder_path      String?   @db.VarChar(255)
  created_at       DateTime? @default(now()) @db.Timestamp(0)
  updated_at       DateTime? @default(now()) @db.Timestamp(0)

  posts              posts[]              @relation("PostFeaturedImage")
  user_avatars       users[]              @relation("UserAvatar")
  ticket_attachments ticket_attachments[]
  chat_attachments   chat_attachments[]

  @@index([document_id], map: "idx_files_document_id")
  @@index([folder_path], map: "idx_files_folder")
  @@index([name], map: "idx_files_name")
}

model issuers {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String         @unique(map: "idx_issuers_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  name          String         @unique(map: "idx_issuers_name") @db.VarChar(255)
  website_url   String?        @db.VarChar(255)
  created_by_id Int?           @db.UnsignedInt
  updated_by_id Int?           @db.UnsignedInt
  locale        String?        @db.VarChar(255)
  created_at    DateTime?      @default(now()) @db.Timestamp(0)
  updated_at    DateTime?      @default(now()) @db.Timestamp(0)
  certificates  certificates[]
}

model organizations {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                 String                 @unique(map: "idx_organizations_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  name                 String                 @db.VarChar(255)
  inn                  String?                @db.VarChar(20)
  address              String?                @db.Text
  email                String?                @db.VarChar(255)
  phone                String?                @db.VarChar(50)
  is_active            Boolean?               @default(true)
  created_by_id        Int?                   @db.UnsignedInt
  updated_by_id        Int?                   @db.UnsignedInt
  locale               String?                @db.VarChar(255)
  created_at           DateTime?              @default(now()) @db.Timestamp(0)
  updated_at           DateTime?              @default(now()) @db.Timestamp(0)
  client_organizations client_organizations[]
  tickets              tickets[]

  @@index([inn], map: "idx_organizations_inn")
}

model pages {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid             String    @unique(map: "idx_pages_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  slug             String    @unique(map: "idx_pages_slug") @db.VarChar(255)
  title            String    @db.VarChar(255)
  sections         Json?
  seo_data         Json?
  meta_title       String?   @db.VarChar(255)
  meta_description String?   @db.VarChar(300)
  created_by_id    Int?      @db.UnsignedInt
  updated_by_id    Int?      @db.UnsignedInt
  locale           String?   @db.VarChar(255)
  created_at       DateTime? @default(now()) @db.Timestamp(0)
  updated_at       DateTime? @default(now()) @db.Timestamp(0)
}

model partners {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique(map: "idx_partners_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  name          String    @db.VarChar(255)
  website_url   String?   @db.VarChar(255)
  image_url     String?   @db.VarChar(500)
  order         Int?      @default(0)
  created_by_id Int?      @db.UnsignedInt
  updated_by_id Int?      @db.UnsignedInt
  locale        String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
}

model posts {
  id                     Int                      @id @default(autoincrement()) @db.UnsignedInt
  document_id            String?                  @db.VarChar(255)
  title                  String?                  @db.VarChar(255)
  slug                   String?                  @unique(map: "idx_posts_slug") @db.VarChar(255)
  content                Json?
  excerpt                String?                  @db.LongText
  post_status            String?                  @default("draft") @db.VarChar(255)
  views                  Int?                     @default(0)
  is_featured            Boolean?                 @default(false)
  meta_title             String?                  @db.VarChar(255)
  meta_description       String?                  @db.LongText
  created_at             DateTime?                @db.DateTime(6)
  updated_at             DateTime?                @db.DateTime(6)
  published_at           DateTime?                @db.DateTime(6)
  created_by_id          Int?                     @db.UnsignedInt
  updated_by_id          Int?                     @db.UnsignedInt
  author_id              Int?                     @db.UnsignedInt
  featured_image_id      Int?                     @db.UnsignedInt
  locale                 String?                  @db.VarChar(255)

  author                 users?                   @relation("PostAuthor", fields: [author_id], references: [id], onUpdate: NoAction, map: "fk_posts_author")
  users                  users?                   @relation("PostCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "fk_posts_created_by")
  featured_image         files?                   @relation("PostFeaturedImage", fields: [featured_image_id], references: [id], onUpdate: NoAction, map: "fk_posts_featured_image")
  posts_categories_links posts_categories_links[]

  @@index([author_id], map: "idx_posts_author_id")
  @@index([created_by_id], map: "idx_posts_created_by_id")
  @@index([document_id], map: "idx_posts_document_id")
  @@index([featured_image_id], map: "idx_posts_featured_image_id")
}

model posts_categories_links {
  id            Int        @id @default(autoincrement()) @db.UnsignedInt
  post_id       Int        @db.UnsignedInt
  category_id   Int        @db.UnsignedInt
  created_at    DateTime?  @db.DateTime(6)
  updated_at    DateTime?  @db.DateTime(6)
  created_by_id Int?       @db.UnsignedInt
  updated_by_id Int?       @db.UnsignedInt
  locale        String?    @db.VarChar(255)
  categories    categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_posts_categories_links_category")
  posts         posts      @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_posts_categories_links_post")

  @@unique([post_id, category_id], map: "idx_posts_categories_links_unique")
  @@index([category_id], map: "idx_posts_categories_links_category")
  @@index([post_id], map: "idx_posts_categories_links_post")
}

model priorities {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique(map: "idx_priorities_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  name          String    @db.VarChar(100)
  code          String?   @unique(map: "idx_priorities_code") @db.VarChar(50)
  color         String?   @db.VarChar(20)
  level         Int       @default(0)
  created_by_id Int?      @db.UnsignedInt
  updated_by_id Int?      @db.UnsignedInt
  locale        String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  tickets       tickets[]
}

model roles {
  id             Int              @id @default(autoincrement()) @db.UnsignedInt
  uuid           String           @unique(map: "idx_roles_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  name           String           @unique(map: "idx_roles_name") @db.VarChar(100)
  type           String?          @db.VarChar(50)
  description    String?          @db.VarChar(255)
  created_by_id  Int?             @db.UnsignedInt
  updated_by_id  Int?             @db.UnsignedInt
  locale         String?          @db.VarChar(255)
  created_at     DateTime?        @default(now()) @db.Timestamp(0)
  updated_at     DateTime?        @default(now()) @db.Timestamp(0)
  users_role_lnk users_role_lnk[]
}

model settings {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  key         String    @unique(map: "idx_settings_key") @db.VarChar(255)
  value       String?   @db.LongText
  description String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
}

model statuses {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique(map: "idx_statuses_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  name          String    @db.VarChar(100)
  code          String?   @unique(map: "idx_statuses_code") @db.VarChar(50)
  color         String?   @db.VarChar(20)
  sort_order    Int       @default(0)
  is_final      Boolean   @default(false)
  created_by_id Int?      @db.UnsignedInt
  updated_by_id Int?      @db.UnsignedInt
  locale        String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  tickets       tickets[]
  status_history_new   ticket_status_history[] @relation("TicketStatusHistoryNew")
  status_history_old   ticket_status_history[] @relation("TicketStatusHistoryOld")
}

model ticket_categories {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid        String    @unique(map: "idx_ticket_categories_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  name        String    @db.VarChar(255)
  slug        String    @unique(map: "idx_ticket_categories_slug") @db.VarChar(255)
  description String?   @db.Text
  icon        String?   @db.VarChar(50)
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)

  tickets tickets[]

  @@index([is_active, sort_order], map: "idx_ticket_categories_active")
}

model ticket_comments {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String    @unique(map: "idx_ticket_comments_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  ticket_uuid   String    @db.Char(36)
  user_uuid     String    @db.Char(36)
  content       String    @db.Text
  is_internal   Boolean?  @default(false)
  created_by_id Int?      @db.UnsignedInt
  updated_by_id Int?      @db.UnsignedInt
  locale        String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  tickets       tickets   @relation(fields: [ticket_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_ticket_comments_ticket")
  users         users     @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_ticket_comments_user")

  attachments   ticket_attachments[]   // ← добавлено

  @@index([ticket_uuid], map: "idx_ticket_comments_ticket")
  @@index([user_uuid], map: "idx_ticket_comments_user")
}

model ticket_attachments {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid         String    @unique(map: "idx_ticket_attachments_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  ticket_uuid  String    @db.Char(36)
  comment_uuid String?   @db.Char(36)
  file_id      Int       @db.UnsignedInt
  created_at   DateTime? @default(now()) @db.Timestamp(0)

  tickets  tickets          @relation(fields: [ticket_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_ticket_attachments_ticket")
  comments ticket_comments? @relation(fields: [comment_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_ticket_attachments_comment")
  files    files            @relation(fields: [file_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_ticket_attachments_file")

  @@index([ticket_uuid], map: "idx_ticket_attachments_ticket")
  @@index([comment_uuid], map: "idx_ticket_attachments_comment")
  @@index([file_id], map: "idx_ticket_attachments_file")
}

model tickets {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid             String    @unique(map: "idx_tickets_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  title            String    @db.VarChar(255)
  description      String?   @db.Text

  contact_name      String? @db.VarChar(255)
  contact_email     String? @db.VarChar(255)
  contact_phone     String? @db.VarChar(50)
  organization_uuid String? @db.Char(36)

  client_uuid      String? @db.Char(36)
  assigned_to_uuid String? @db.Char(36)
  status_uuid      String? @db.Char(36)
  priority_uuid    String? @db.Char(36)
  category_uuid    String? @db.Char(36)

  deadline_at   DateTime? @db.Timestamp(0)
  resolved_at   DateTime? @db.Timestamp(0)
  created_by_id Int?      @db.UnsignedInt
  updated_by_id Int?      @db.UnsignedInt
  locale        String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)

  ticket_comments ticket_comments[]
  attachments     ticket_attachments[]
  status_history  ticket_status_history[]
  chat            chats?

  assignee      users?         @relation("TicketAssignee", fields: [assigned_to_uuid], references: [uuid], onUpdate: NoAction, map: "fk_tickets_assigned")
  ticket_category ticket_categories? @relation(fields: [category_uuid], references: [uuid], onUpdate: NoAction, map: "fk_tickets_category")
  client        users?         @relation("TicketClient", fields: [client_uuid], references: [uuid], onUpdate: NoAction, map: "fk_tickets_client")
  created_by    users?         @relation("TicketCreatedBy", fields: [created_by_id], references: [id], onUpdate: NoAction, map: "fk_tickets_created_by")
  organization  organizations? @relation(fields: [organization_uuid], references: [uuid], onUpdate: NoAction, map: "fk_tickets_organization")
  priorities    priorities?    @relation(fields: [priority_uuid], references: [uuid], onUpdate: NoAction, map: "fk_tickets_priority")
  statuses      statuses?      @relation(fields: [status_uuid], references: [uuid], onUpdate: NoAction, map: "fk_tickets_status")

  @@index([assigned_to_uuid], map: "idx_tickets_assigned")
  @@index([category_uuid], map: "idx_tickets_category")
  @@index([client_uuid], map: "idx_tickets_client")
  @@index([created_at], map: "idx_tickets_created_at")
  @@index([deadline_at], map: "idx_tickets_deadline_at")
  @@index([organization_uuid], map: "idx_tickets_organization")
  @@index([priority_uuid], map: "idx_tickets_priority")
  @@index([status_uuid], map: "idx_tickets_status")
}

model ticket_status_history {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String    @unique(map: "idx_ticket_status_history_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)

  ticket_uuid     String    @db.Char(36)
  status_uuid     String?   @db.Char(36)   // новый статус
  old_status_uuid String?   @db.Char(36)   // предыдущий статус (для истории)

  changed_by_uuid String?   @db.Char(36)   // кто сменил
  comment         String?   @db.VarChar(500) // опционально: причина смены

  created_at      DateTime? @default(now()) @db.Timestamp(0)

  tickets     tickets   @relation(fields: [ticket_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_tsh_ticket")
  statuses    statuses? @relation("TicketStatusHistoryNew", fields: [status_uuid],     references: [uuid], onDelete: SetNull, onUpdate: NoAction, map: "fk_tsh_status")
  old_status  statuses? @relation("TicketStatusHistoryOld", fields: [old_status_uuid], references: [uuid], onDelete: SetNull, onUpdate: NoAction, map: "fk_tsh_old_status")
  changed_by  users?    @relation("TicketStatusChangedBy",  fields: [changed_by_uuid], references: [uuid], onDelete: SetNull, onUpdate: NoAction, map: "fk_tsh_user")

  @@index([ticket_uuid, created_at], map: "idx_tsh_ticket_created")
  @@index([changed_by_uuid], map: "idx_tsh_user")
  @@index([status_uuid], map: "idx_tsh_status")
}

model users {
  id                     Int                @id @default(autoincrement()) @db.UnsignedInt
  uuid                   String             @unique(map: "idx_users_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  document_id            String?            @db.VarChar(255)
  username               String?            @unique(map: "idx_users_username") @db.VarChar(255)
  email                  String?            @unique(map: "idx_users_email") @db.VarChar(255)
  password_hash          String?            @db.VarChar(255)
  full_name              String?            @db.VarChar(255)
  phone                  String?            @db.VarChar(255)
  avatar_url             String?            @db.VarChar(500)
  avatar_id              Int?               @db.UnsignedInt
  bio                    String?            @db.LongText
  is_active              Boolean?           @default(true)
  last_login             DateTime?          @db.DateTime(6)
  provider               String?            @db.VarChar(255)
  confirmed              Boolean?           @default(false)
  blocked                Boolean?           @default(false)
  reset_password_token   String?            @db.VarChar(255)
  reset_password_expires DateTime?          @db.DateTime(6)
  confirmation_token     String?            @db.VarChar(255)
  created_at             DateTime?          @db.DateTime(6)
  updated_at             DateTime?          @db.DateTime(6)
  published_at           DateTime?          @db.DateTime(6)
  created_by_id          Int?               @db.UnsignedInt
  updated_by_id          Int?               @db.UnsignedInt
  locale                 String?            @db.VarChar(255)

  client_organizations  client_organizations[]
  clients               clients?
  posts                 posts[]                 @relation("PostCreatedBy")
  postsAuthored         posts[]                 @relation("PostAuthor")
  ticket_comments       ticket_comments[]
  ticketsAssigned       tickets[]               @relation("TicketAssignee")
  ticketsClient         tickets[]               @relation("TicketClient")
  ticketsCreated        tickets[]               @relation("TicketCreatedBy")
  avatar                files?                  @relation("UserAvatar", fields: [avatar_id], references: [id], onUpdate: NoAction, map: "fk_users_avatar")
  ticket_status_changes ticket_status_history[] @relation("TicketStatusChangedBy")
  chats_created         chats[]                 @relation("ChatCreatedBy")
  chat_members          chat_members[]
  chat_messages         chat_messages[]
  chat_message_deletions chat_message_deletions[]
  chat_reactions        chat_reactions[]
  chat_read_receipts    chat_read_receipts[]
  users_role_lnk        users_role_lnk[]
  workers               workers?

  @@index([avatar_id], map: "idx_users_avatar_id")
  @@index([document_id], map: "idx_users_document_id")
}

model users_role_lnk {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  user_id    Int       @db.UnsignedInt
  role_id    Int       @db.UnsignedInt
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  roles      roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_users_role_lnk_role")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_users_role_lnk_user")

  @@unique([user_id, role_id], map: "idx_users_role_lnk_unique")
  @@index([role_id], map: "fk_users_role_lnk_role")
}

model workers {
  user_uuid     String    @id @db.Char(36)
  position      String?   @db.VarChar(255)
  created_by_id Int?      @db.UnsignedInt
  updated_by_id Int?      @db.UnsignedInt
  locale        String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  users         users     @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_workers_user")
}

// ============================================
// ЧАТЫ: ЛС, группы, каналы, чаты тикетов
// ============================================
model chats {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String    @unique(map: "idx_chats_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)

  // "direct" — ЛС (2 участника)
  // "group" — группа (3+)
  // "channel" — публичный канал
  // "private_channel" — приватный канал
  // "ticket" — чат, привязанный к тикету
  kind            String    @db.VarChar(20)

  name            String?   @db.VarChar(255)
  description     String?   @db.VarChar(500)
  avatar_url      String?   @db.VarChar(500)
  is_archived     Boolean   @default(false)

  // для kind="direct" — детерминированный ключ из двух uuid
  direct_key      String?   @unique(map: "idx_chats_direct_key") @db.VarChar(80)

  ticket_uuid     String?   @unique(map: "idx_chats_ticket_unique") @db.Char(36)
  created_by_uuid String?   @db.Char(36)
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  updated_at      DateTime? @default(now()) @db.Timestamp(0)
  last_message_at DateTime? @db.Timestamp(0)

  ticket          tickets?  @relation(fields: [ticket_uuid], references: [uuid], onDelete: SetNull, onUpdate: NoAction, map: "fk_chats_ticket")
  created_by      users?    @relation("ChatCreatedBy", fields: [created_by_uuid], references: [uuid], onDelete: SetNull, onUpdate: NoAction, map: "fk_chats_creator")
  members         chat_members[]
  messages        chat_messages[]

  @@index([kind], map: "idx_chats_kind")
  @@index([last_message_at], map: "idx_chats_last_message")
}

model chat_members {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String    @unique(map: "idx_chat_members_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)

  chat_uuid       String    @db.Char(36)
  user_uuid       String    @db.Char(36)

  // "owner" | "admin" | "member"
  role            String    @default("member") @db.VarChar(20)

  joined_at       DateTime? @default(now()) @db.Timestamp(0)
  last_read_at    DateTime? @db.Timestamp(0)
  last_read_message_uuid String? @db.Char(36)
  unread_count    Int       @default(0)
  is_muted        Boolean   @default(false)
  is_pinned       Boolean   @default(false)

  chat            chats     @relation(fields: [chat_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_members_chat")
  user            users     @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_members_user")

  @@unique([chat_uuid, user_uuid], map: "idx_chat_members_unique")
  @@index([user_uuid], map: "idx_chat_members_user")
  @@index([chat_uuid], map: "idx_chat_members_chat")
}

model chat_messages {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String    @unique(map: "idx_chat_messages_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)

  chat_uuid       String    @db.Char(36)
  user_uuid       String?   @db.Char(36)

  kind            String    @default("text") @db.VarChar(20)
  content         String    @db.Text
  reply_to_uuid   String?   @db.Char(36)
  edited_at       DateTime? @db.Timestamp(0)
  deleted_at      DateTime? @db.Timestamp(0)

  forwarded_from_message_uuid String? @db.Char(36)
  forwarded_from_chat_uuid    String? @db.Char(36)
  forwarded_from_user_uuid    String? @db.Char(36)

  created_at      DateTime? @default(now()) @db.Timestamp(0)

  chat            chats     @relation(fields: [chat_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_messages_chat")
  user            users?    @relation(fields: [user_uuid], references: [uuid], onDelete: SetNull, onUpdate: NoAction, map: "fk_chat_messages_user")
  reply_to        chat_messages? @relation("ReplyTo", fields: [reply_to_uuid], references: [uuid], onDelete: SetNull, onUpdate: NoAction, map: "fk_chat_messages_reply")
  replies         chat_messages[] @relation("ReplyTo")
  attachments     chat_attachments[]
  reactions       chat_reactions[]
  read_receipts   chat_read_receipts[]
  deletions       chat_message_deletions[]

  @@index([chat_uuid, created_at], map: "idx_chat_messages_chat_created")
  @@index([user_uuid], map: "idx_chat_messages_user")
}

model chat_message_deletions {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid         String    @unique(map: "idx_chat_message_deletions_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)

  message_uuid String    @db.Char(36)
  user_uuid    String    @db.Char(36)
  created_at   DateTime? @default(now()) @db.Timestamp(0)

  message      chat_messages @relation(fields: [message_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_cmd_message")
  user         users         @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_cmd_user")

  @@unique([message_uuid, user_uuid], map: "idx_cmd_unique")
  @@index([user_uuid], map: "idx_cmd_user")
  @@index([message_uuid], map: "idx_cmd_message")
}

model chat_attachments {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String    @unique(map: "idx_chat_attachments_uuid") @default(dbgenerated("(uuid())")) @db.Char(36)

  message_uuid    String    @db.Char(36)
  file_id         Int       @db.UnsignedInt
  created_at      DateTime? @default(now()) @db.Timestamp(0)

  message         chat_messages @relation(fields: [message_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_attachments_message")
  file            files         @relation(fields: [file_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_chat_attachments_file")

  @@index([message_uuid], map: "idx_chat_attachments_message")
  @@index([file_id], map: "idx_chat_attachments_file")
}

model chat_reactions {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  message_uuid    String    @db.Char(36)
  user_uuid       String    @db.Char(36)
  emoji           String    @db.VarChar(10)
  created_at      DateTime? @default(now()) @db.Timestamp(0)

  message         chat_messages @relation(fields: [message_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_reactions_message")
  user            users         @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_reactions_user")

  @@unique([message_uuid, user_uuid, emoji], map: "idx_chat_reactions_unique")
  @@index([message_uuid], map: "idx_chat_reactions_message")
}

model chat_read_receipts {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  message_uuid    String    @db.Char(36)
  user_uuid       String    @db.Char(36)
  read_at         DateTime? @default(now()) @db.Timestamp(0)

  message         chat_messages @relation(fields: [message_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_read_receipts_message")
  user            users         @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_read_receipts_user")

  @@unique([message_uuid, user_uuid], map: "idx_chat_read_receipts_unique")
  @@index([user_uuid, read_at], map: "idx_chat_read_receipts_user")
}
