# Скопируйте этот файл в .env.local и заполните своими значениями

USE_PRISMA="1"
HOST=0.0.0.0
PORT=3000

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="<openssl rand -base64 32>"

DATABASE_URL="mysql://user:password@localhost:3306/motit_site"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="motit-uploads"
S3_ACCESS_KEY_ID="<key>"
S3_SECRET_ACCESS_KEY="<secret>"
S3_PUBLIC_URL="http://localhost:9000/motit-uploads"
S3_FORCE_PATH_STYLE="true"
NEXT_PUBLIC_S3_URL="http://localhost:9000/motit-uploads"

# SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="you@example.com"
SMTP_PASS="<app-password>"
SMTP_FROM_NAME="Motit | Официальный сайт"
SMTP_FROM_EMAIL="you@example.com"
CONTACT_EMAIL="you@example.com"

# Help Desk (опционально)
HELP_DESK_TYPE=hesk_form
HESK_API_URL="https://help.example.com"
HESK_API_TOKEN=""
HESK_CATEGORY_ID=1
