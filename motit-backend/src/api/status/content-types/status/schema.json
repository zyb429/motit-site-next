{
  "kind": "collectionType",
  "collectionName": "statuses",
  "info": {
    "singularName": "status",
    "pluralName": "statuses",
    "displayName": "Statuses"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 100
    },
    "color": {
      "type": "enumeration",
      "enum": ["blue", "purple", "yellow", "green", "orange", "gray", "red"],
      "default": "blue",
      "required": true
    },
    "description": {
      "type": "string",
      "maxLength": 255
    },
    "tickets": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ticket.ticket",
      "mappedBy": "ticket_status"
    }
  }
}