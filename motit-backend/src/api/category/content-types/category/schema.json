{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "required": true,
      "regex": "^[a-zA-Zа-яА-Я0-9\\s\\-]+$"
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "minLength": 1,
      "maxLength": 255,
      "regex": "^[a-z0-9\\-]+$"
    },
    "description": {
      "type": "text",
      "maxLength": 500,
      "required": false
    },
    "icon": {
      "type": "string",
      "maxLength": 10
    },
    "posts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::post.post",
      "inversedBy": "categories"
    }
  }
}
